{
    "layer": "top",
    "exclusive": true,
    "position": "top",
    "height": 30,
    "spacing": 0,

    "modules-left": ["sway/workspaces"],
    "modules-center": ["clock"],
    "modules-right": [
        "tray",
        "custom/bluetooth",
        "custom/power-profile",
        "battery#bat0",
        "battery#bat1",
        "pulseaudio",
        "network",
        "custom/notifications",
        "custom/lock",
        "custom/reboot",
        "custom/suspend",
        "custom/poweroff",
        "custom/power"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "clock": {
        "format": "{:L%a %d.%m.%Y  %H:%M}",
        // German weekdays, week starts on Monday (needs locale-gen, see README).
        // The "L" in the format applies the locale.
        "locale": "de_DE.UTF-8",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "left",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#b794f6'><b>{}</b></span>",
                "weekdays": "<span color='#a6adc8'><b>{}</b></span>",
                "weeks":    "<span color='#6c7086'>{}</span>",
                "days":     "<span color='#cdd6f4'>{}</span>",
                "today":    "<span color='#1e1e2e' background='#b794f6'><b>{}</b></span>"
            }
        },
        // Scroll: change month, middle click: back to today,
        // right click: month/year view
        "actions": {
            "on-click-right": "mode",
            "on-click-middle": "shift_reset",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "tray": {
        "spacing": 10
    },

    // Reads the profile via busctl (no Python); after a switch
    // from the menu, signal 9 updates it right away.
    "custom/power-profile": {
        "exec": "~/.config/waybar/power-profile.sh",
        "return-type": "json",
        "interval": 10,
        "signal": 9,
        "on-click": "~/.config/waybar/power-profile.sh menu"
    },

    // Check battery names with: ls /sys/class/power_supply
    "battery#bat0": {
        "bat": "BAT0",
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": "<span color='#a6e3a1'>\uf0e7</span> {capacity}%",
        "format-plugged": "<span color='#a6e3a1'>\uf1e6</span> {capacity}%",
        "format-full": "<span color='#a6e3a1'>\uf1e6</span> {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "tooltip-format": "Intern: {capacity}% ({timeTo})"
    },

    "battery#bat1": {
        "bat": "BAT1",
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": "<span color='#a6e3a1'>\uf0e7</span> {capacity}%",
        "format-plugged": "<span color='#a6e3a1'>\uf1e6</span> {capacity}%",
        "format-full": "<span color='#a6e3a1'>\uf1e6</span> {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "tooltip-format": "Extern: {capacity}% ({timeTo})"
    },

    // Right/middle click open the menu too: on the touchpad (button areas)
    // a press in the lower right/middle counts as a right/middle click.
    "custom/bluetooth": {
        "exec": "~/.config/waybar/bt-status.sh",
        "return-type": "json",
        "interval": 5,
        "signal": 8,
        "on-click": "~/.config/waybar/bt-menu.sh",
        "on-click-right": "~/.config/waybar/bt-menu.sh",
        "on-click-middle": "~/.config/waybar/bt-menu.sh"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "\uf026 stumm",
        "format-icons": { "default": ["\uf027", "\uf028"] },
        "scroll-step": 5,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },

    "network": {
        "format-wifi": "\uf1eb",
        "format-ethernet": "\uf6ff",
        // connected, but no IP address (yet)
        "format-linked": "\uf1eb",
        "format-disconnected": "\uf127",
        // Wi-Fi turned off (nf-md-wifi_off)
        "format-disabled": "\udb81\uddaa",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-linked": "{ifname}: keine IP-Adresse",
        "tooltip-format-disconnected": "Nicht verbunden",
        "tooltip-format-disabled": "WLAN aus",
        // Right/middle click like Bluetooth (touchpad button areas)
        "on-click": "~/.config/waybar/wifi-menu.sh",
        "on-click-right": "~/.config/waybar/wifi-menu.sh",
        "on-click-middle": "~/.config/waybar/wifi-menu.sh"
    },

    // Notification history (mako). mako sends signal 11 via "on-notify",
    // the interval is only a safety net.
    "custom/notifications": {
        "exec": "~/.config/waybar/notifications.sh",
        "return-type": "json",
        "interval": 30,
        "signal": 11,
        "on-click": "~/.config/waybar/notifications.sh menu",
        "on-click-right": "~/.config/waybar/notifications.sh clear"
    },

    // Power menu: clicking the icon on the far right expands the actions to the left.
    // The icon then turns into "<" and closes the menu again on the next click.
    "custom/power": {
        "exec": "~/.config/waybar/power-menu.sh status",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "on-click": "~/.config/waybar/power-menu.sh toggle"
    },
    "custom/lock": {
        "exec": "~/.config/waybar/power-menu.sh item lock",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "on-click": "~/.config/waybar/power-menu.sh run lock"
    },
    "custom/reboot": {
        "exec": "~/.config/waybar/power-menu.sh item reboot",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "on-click": "~/.config/waybar/power-menu.sh run reboot"
    },
    "custom/suspend": {
        "exec": "~/.config/waybar/power-menu.sh item suspend",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "on-click": "~/.config/waybar/power-menu.sh run suspend"
    },
    "custom/poweroff": {
        "exec": "~/.config/waybar/power-menu.sh item poweroff",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "on-click": "~/.config/waybar/power-menu.sh run poweroff"
    }
}
