#!/usr/bin/env python3
"""Animiertes ASCII-Schwarzes-Loch als Sway-Hintergrund.

Legt auf jedem Monitor ein GTK4-Fenster auf die Hintergrund-Ebene (gtk4-layer-shell)
und zeigt darin index.html mit WebKitGTK an. Einstellungen gehen als URL-Parameter
an die Seite (gleiche Namen wie in Wallpaper Engine).

Die Einstellungen kommen aus ~/.config/blackhole/settings.json (geschrieben von
blackhole-settings); Änderungen daran werden sofort übernommen. Ist das Loch für
einen Monitor ausgeschaltet, zeigt er stattdessen ~/.config/sway/wallpaper.png.
Die Optionen unten gelten zusätzlich und haben Vorrang vor der Datei.

  blackhole-wallpaper                                 # alle Monitore, laut settings.json
  blackhole-wallpaper --fps 24 --params "speed=60"    # für alle Monitore
  blackhole-wallpaper --output eDP-1 "blackhole=false"   # nur für einen Monitor
"""
import argparse
import json
import os
import signal
import subprocess
import sys
import urllib.parse
from pathlib import Path

# gtk4-layer-shell muss vor libwayland-client geladen sein, sonst funktioniert es nicht
LAYER_LIB = "libgtk4-layer-shell.so"
if LAYER_LIB not in os.environ.get("LD_PRELOAD", ""):
    os.environ["LD_PRELOAD"] = f"{LAYER_LIB} {os.environ.get('LD_PRELOAD', '')}".strip()
    os.execv(sys.executable, [sys.executable] + sys.argv)

import gi

gi.require_version("Gdk", "4.0")
gi.require_version("Gtk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
gi.require_version("WebKit", "6.0")
from gi.repository import Gdk, Gio, GLib, Gtk, WebKit
from gi.repository import Gtk4LayerShell as LayerShell

HTML = Path(os.environ.get("BLACKHOLE_HTML", "~/.local/share/blackhole/index.html")).expanduser()
PIDFILE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "blackhole-wallpaper.pid"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", "~/.config")).expanduser() / "blackhole"
SETTINGS = CONFIG_DIR / "settings.json"
STILL_IMAGE = Path("~/.config/sway/wallpaper.png").expanduser()
WAYBAR = Path("~/.config/waybar").expanduser()
# Standardfarben wie in index.html
COLORS = {"disk": "#be8cff", "hot": "#f0d7ff", "accent": "#ff50dc", "star": "#c8b9ff"}


def load_settings():
    """settings.json lesen; fehlt sie oder ist sie kaputt, gelten die Standardwerte."""
    try:
        data = json.loads(SETTINGS.read_text())
        return data if isinstance(data, dict) else {}
    except (FileNotFoundError, ValueError):
        return {}


def mix(a, b, f):
    """Wie mix() in GTK-CSS: a * (1 - f) + b * f, Farben als "#rrggbb"."""
    ca, cb = (bytes.fromhex(c.lstrip("#")[:6]) for c in (a, b))
    return "#" + "".join(f"{round(x * (1 - f) + y * f):02x}" for x, y in zip(ca, cb))


def write_waybar_colors(settings):
    """Die Lochfarben (für alle Monitore) für Waybar: colors.css für den Stil, colors.jsonc
    für den Kalender (Pango-Markup kennt keine CSS-Farben). Bei Änderung Waybar neu laden."""
    if not WAYBAR.is_dir():
        return
    chosen = settings.get("all", {})
    c = {name: chosen.get(name + "color", default) for name, default in COLORS.items()}
    # wie @bar_bg und @bar_dim in waybar/style.css
    bg = mix("#000000", c["disk"], 0.08)
    dim = mix(c["star"], bg, 0.55)

    header = "Generated by blackhole-wallpaper from ~/.config/blackhole/settings.json"
    css = f"/* {header} */\n" + "".join(f"@define-color hole_{n} {v};\n" for n, v in c.items())
    span = lambda color, bold=False, extra="": \
        f"<span color='{color}'{extra}>{'<b>{}</b>' if bold else '{}'}</span>"
    calendar = {"clock": {"calendar": {"format": {
        "months": span(c["disk"], True),
        "weekdays": span(c["star"], True),
        "weeks": span(dim),
        "days": span(c["hot"]),
        "today": span(bg, True, f" background='{c['disk']}'"),
    }}}}
    files = {WAYBAR / "colors.css": css,
             WAYBAR / "colors.jsonc": f"// {header}\n" + json.dumps(calendar, indent=4) + "\n"}

    changed = False
    for path, text in files.items():
        try:
            if path.read_text() == text:
                continue
        except FileNotFoundError:
            pass
        path.write_text(text)
        changed = True
    if changed:
        subprocess.run(["pkill", "-USR2", "-x", "waybar"], check=False)  # SIGUSR2: neu laden


def replace_running_instance():
    """Eine bereits laufende Instanz beenden (für exec_always beim Sway-Reload)."""
    try:
        old = int(PIDFILE.read_text())
        if old != os.getpid():
            os.kill(old, signal.SIGTERM)
    except (FileNotFoundError, ValueError, ProcessLookupError, PermissionError):
        pass
    PIDFILE.write_text(str(os.getpid()))


def parse_args():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--fps", type=int, help="Bildrate begrenzen (Standard: 30, 0 = unbegrenzt)")
    p.add_argument("--params", default="", help='Parameter für alle Monitore, z. B. "speed=60&starsize=14"')
    p.add_argument("--output", nargs=2, action="append", default=[], metavar=("NAME", "PARAMS"),
                   help="Parameter nur für diesen Monitor (mehrfach möglich)")
    p.add_argument("--colors-only", action="store_true",
                   help="nur die Farbdateien für Waybar schreiben und beenden")
    return p.parse_args()


class Wallpaper(Gtk.Application):
    def __init__(self, args):
        super().__init__(application_id="de.purplecloud.blackhole", flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.args = args
        self.per_output = dict(args.output)
        self.settings = load_settings()
        self.windows = {}                             # Anschluss -> (Fenster, WebView oder None)
        self.reload_id = 0

    def do_activate(self):
        self.hold()                                   # weiterlaufen, auch wenn kurz kein Monitor da ist
        monitors = Gdk.Display.get_default().get_monitors()
        monitors.connect("items-changed", lambda *_: GLib.idle_add(self.rebuild))
        # den Ordner beobachten: Programme ersetzen die Datei beim Speichern meist
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        self.monitor = Gio.File.new_for_path(str(CONFIG_DIR)).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
        self.monitor.connect("changed", self.on_config_changed)
        write_waybar_colors(self.settings)
        self.rebuild()

    def fps(self):
        if self.args.fps is not None:
            return self.args.fps
        return self.settings.get("fps", 30)

    def output_settings(self, connector):
        return self.settings.get("outputs", {}).get(connector, {})

    def enabled(self, connector):
        return self.output_settings(connector).get("enabled", True)

    def params_for(self, connector):
        """Alle Parameter für einen Monitor: Datei (alle, dann eigene), dann Kommandozeile."""
        out = self.output_settings(connector)
        params = dict(self.settings.get("all", {}))
        if out.get("own"):
            params.update(out.get("settings", {}))
        params.update(urllib.parse.parse_qsl(self.args.params))
        params.update(urllib.parse.parse_qsl(self.per_output.get(connector, "")))
        # area=false: jeder Monitor hat seine eigene Instanz, das Loch sitzt mittig
        params["area"] = False
        return params

    def url_for(self, connector):
        query = {k: str(v).lower() if isinstance(v, bool) else v for k, v in self.params_for(connector).items()}
        query["fps"] = self.fps()
        return f"{HTML.as_uri()}?{urllib.parse.urlencode(query)}"

    def on_config_changed(self, _monitor, file, other, _event):
        names = {f.get_basename() for f in (file, other) if f}
        if SETTINGS.name not in names:
            return
        # mehrere Ereignisse pro Speichern zusammenfassen
        if self.reload_id:
            GLib.source_remove(self.reload_id)
        self.reload_id = GLib.timeout_add(50, self.reload)

    def reload(self):
        self.reload_id = 0
        old = {c: self.enabled(c) for c in self.windows}
        self.settings = load_settings()
        write_waybar_colors(self.settings)
        if any(self.enabled(c) != was for c, was in old.items()):
            self.rebuild()                            # Loch an/aus: Fenster neu aufbauen
            return GLib.SOURCE_REMOVE
        for connector, (_win, view) in self.windows.items():
            if view:                                  # live übernehmen, ohne neu zu laden
                script = f"blackholeSet({json.dumps(self.params_for(connector))}, {json.dumps(self.fps())})"
                view.evaluate_javascript(script, -1, None, None, None, None, None)
        return GLib.SOURCE_REMOVE

    def rebuild(self):
        for win, _view in self.windows.values():
            win.destroy()
        self.windows = {}
        monitors = Gdk.Display.get_default().get_monitors()
        for i in range(monitors.get_n_items()):
            monitor = monitors.get_item(i)
            self.windows[monitor.get_connector()] = self.make_window(monitor)
        return GLib.SOURCE_REMOVE

    def make_window(self, monitor):
        win = Gtk.ApplicationWindow(application=self)
        LayerShell.init_for_window(win)
        LayerShell.set_namespace(win, "blackhole-wallpaper")
        LayerShell.set_layer(win, LayerShell.Layer.BACKGROUND)
        LayerShell.set_monitor(win, monitor)
        for edge in (LayerShell.Edge.TOP, LayerShell.Edge.BOTTOM, LayerShell.Edge.LEFT, LayerShell.Edge.RIGHT):
            LayerShell.set_anchor(win, edge, True)
        LayerShell.set_exclusive_zone(win, -1)
        LayerShell.set_keyboard_mode(win, LayerShell.KeyboardMode.NONE)

        connector = monitor.get_connector()
        view = None
        if self.enabled(connector):
            view = WebKit.WebView()
            settings = view.get_settings()
            settings.set_hardware_acceleration_policy(WebKit.HardwareAccelerationPolicy.ALWAYS)
            settings.set_enable_developer_extras(False)
            black = Gdk.RGBA()
            black.parse("black")
            view.set_background_color(black)
            view.load_uri(self.url_for(connector))
            win.set_child(view)
        else:                                         # Loch aus: Standbild statt Animation
            picture = Gtk.Picture.new_for_filename(str(STILL_IMAGE))
            picture.set_content_fit(Gtk.ContentFit.COVER)
            win.set_child(picture)

        win.present()
        return win, view


def main():
    args = parse_args()
    if args.colors_only:
        write_waybar_colors(load_settings())
        return
    if not HTML.exists():
        sys.exit(f"index.html nicht gefunden: {HTML}")
    replace_running_instance()
    app = Wallpaper(args)
    try:
        gi.require_version("GLibUnix", "2.0")
        from gi.repository import GLibUnix
        signal_add = GLibUnix.signal_add
    except (ValueError, ImportError):                 # ältere PyGObject-Versionen
        signal_add = GLib.unix_signal_add
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal_add(GLib.PRIORITY_DEFAULT, sig, app.quit)
    sys.exit(app.run([sys.argv[0]]))


if __name__ == "__main__":
    main()
