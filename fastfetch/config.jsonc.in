// Minimal fastfetch: the moon (patch.svg.in) and nine lines next to it,
// exactly as tall as the image (18x9 cells). fastfetch keeps a blank logo
// area free, the fastfetch function in station/shell.bash draws the sixel
// image into it. Without resvg/ImageMagick: the text moon (also 18x9).
// Template: `station theme` writes config.jsonc from it with the theme's
// name and colours and the logo (@...@). Edit this file, not config.jsonc.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "@LOGO_TYPE@",
        "source": "@LOGO_SOURCE@",
        "width": @LOGO_WIDTH@,
        "height": @LOGO_HEIGHT@,
        "color": {
            "1": "@FG@",
            "2": "@FG2@",
            "3": "@FAINT@"
        },
        "padding": {
            "top": 0,
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "@MUTED@",
            "title": "@ACCENT@",
            "output": "@FG@",
            "separator": "@BORDER@"
        },
        "key": {
            "width": 10
        }
    },
    "modules": [
        "title",
        { "type": "os", "key": "OS", "format": "{name}" },
        { "type": "kernel", "key": "KERNEL", "format": "{release}" },
        { "type": "wm", "key": "WM", "format": "{pretty-name}" },
        { "type": "uptime", "key": "UPTIME" },
        { "type": "command", "key": "THEME", "text": "echo @THEME@" },
        { "type": "packages", "key": "PACKAGES", "format": "{all}" },
        { "type": "command", "key": "BATTERY", "text": "station battery | cut -d' ' -f2-" },
        { "type": "colors", "symbol": "block", "paddingLeft": 0, "block": { "range": [0, 7] } }
    ]
}
