// fastfetch with the pixel moon (canvas board 01).
// Template: `station theme` writes config.jsonc from it with the theme's
// colours (@...@). Edit this file, not config.jsonc.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/moon.txt",
        "color": {
            "1": "@FG@",
            "2": "@FG2@",
            "3": "@FAINT@"
        },
        "padding": {
            "top": 1,
            "left": 1,
            "right": 4
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "@MUTED@",
            "title": "@ACCENT@",
            "output": "@FG@",
            "separator": "@BORDER@"
        },
        "key": {
            "width": 10
        }
    },
    "modules": [
        "title",
        "separator",
        { "type": "os", "key": "OS", "format": "{name} {arch}" },
        { "type": "host", "key": "HOST", "format": "{family}" },
        { "type": "kernel", "key": "KERNEL", "format": "{release}" },
        { "type": "uptime", "key": "UPTIME" },
        { "type": "packages", "key": "PACKAGES" },
        { "type": "wm", "key": "WM" },
        { "type": "command", "key": "SHELL-UI", "text": "qs --version 2>/dev/null | head -1 || echo Quickshell" },
        { "type": "terminal", "key": "TERMINAL" },
        { "type": "terminalfont", "key": "FONT" },
        { "type": "gpu", "key": "GPU", "format": "{name}" },
        { "type": "battery", "key": "BATTERY" },
        "break",
        { "type": "colors", "symbol": "block", "paddingLeft": 0 }
    ]
}
