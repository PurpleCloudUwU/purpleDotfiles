// fastfetch with the moon and the rocket (patch.svg.in): fastfetch keeps a
// blank logo area free, the fastfetch function in station/shell.bash draws
// the sixel image into it. Without resvg/ImageMagick: the text moon.
// Template: `station theme` writes config.jsonc from it with the theme's
// colours and the logo (@...@). Edit this file, not config.jsonc.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "@LOGO_TYPE@",
        "source": "@LOGO_SOURCE@",
        "width": @LOGO_WIDTH@,
        "height": @LOGO_HEIGHT@,
        "color": {
            "1": "@FG@",
            "2": "@FG2@",
            "3": "@FAINT@"
        },
        "padding": {
            "top": 0,
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "@MUTED@",
            "title": "@ACCENT@",
            "output": "@FG@",
            "separator": "@BORDER@"
        },
        "key": {
            "width": 10
        }
    },
    "modules": [
        "title",
        "separator",
        { "type": "os", "key": "OS", "format": "{name} {arch}" },
        { "type": "host", "key": "HOST", "format": "{family}" },
        { "type": "kernel", "key": "KERNEL", "format": "{release}" },
        { "type": "uptime", "key": "UPTIME" },
        { "type": "packages", "key": "PACKAGES" },
        { "type": "wm", "key": "WM" },
        { "type": "command", "key": "SHELL-UI", "text": "qs --version 2>/dev/null | head -1 | cut -d' ' -f1-2" },
        { "type": "terminal", "key": "TERMINAL" },
        { "type": "terminalfont", "key": "FONT", "format": "{name}" },
        { "type": "gpu", "key": "GPU", "format": "{name}" },
        { "type": "battery", "key": "BATTERY" },
        "break",
        { "type": "colors", "symbol": "block", "paddingLeft": 0 }
    ]
}
