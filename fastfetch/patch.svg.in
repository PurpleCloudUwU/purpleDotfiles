<!--
  fastfetch logo: the moon and a rocket flying around it, its trail fading
  behind it. Drawn on an 84x56 pixel grid without anti-aliasing and with a
  transparent background; `station theme` fills in the colours (@...@),
  renders it with resvg and scales it up 5x with hard pixel edges to
  420x280 px, exactly 30x10 of foot's 14x28 px cells (22 px Departure Mono).
-->
<svg xmlns="http://www.w3.org/2000/svg" width="84" height="56" viewBox="0 0 84 56"
     shape-rendering="crispEdges">
  <defs>
    <clipPath id="moon">
      <circle cx="30" cy="27" r="17"/>
    </clipPath>
  </defs>

  <!-- Moon: lit disc, craters, the shadow side -->
  <circle cx="30" cy="27" r="17" fill="@FG@"/>
  <g fill="@FG2@">
    <circle cx="23" cy="20" r="4"/>
    <circle cx="33" cy="35" r="3"/>
    <circle cx="21" cy="33" r="2"/>
    <circle cx="35" cy="17" r="2"/>
  </g>
  <circle cx="50" cy="21" r="19" fill="@FAINT@" clip-path="url(#moon)"/>

  <!-- The trail along the near side of the orbit, fading towards the past,
       and the rocket at its head -->
  <g transform="rotate(-16 36 30)" fill="none">
    <path d="M 3.16 32.85 A 34 11 0 0 0 19 39.53" stroke="@ACCENT2@" stroke-width="1" opacity="0.45"/>
    <path d="M 19 39.53 A 34 11 0 0 0 41.9 40.83" stroke="@ACCENT2@" stroke-width="2" opacity="0.75"/>
    <path d="M 41.9 40.83 A 34 11 0 0 0 62.79 36.77" stroke="@ACCENT@" stroke-width="2"/>

    <g transform="translate(65.4 35.5) rotate(-29) scale(1.3)">
      <rect x="-12" y="-0.5" width="2" height="1" fill="@FG2@"/>
      <rect x="-10" y="-1" width="3" height="2" fill="@ACCENT@"/>
      <polygon points="-6,-2 -4,-2 -8,-5" fill="@ACCENT@"/>
      <polygon points="-6,2 -4,2 -8,5" fill="@ACCENT@"/>
      <rect x="-7" y="-2" width="10" height="4" fill="@FG@"/>
      <polygon points="3,-2 7,0 3,2" fill="@FG@"/>
      <rect x="-1" y="-1" width="2" height="2" fill="@ACCENT2@"/>
    </g>
  </g>
</svg>
