<!--
  Mission patch for fastfetch: the moon with a rocket on its orbit, the trail
  fading behind it, like a NASA mission patch. Drawn on a 96x96 pixel grid
  without anti-aliasing; `station theme` fills in the colours (@...@),
  renders it with resvg and scales it up 4x with hard pixel edges.
-->
<svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" viewBox="0 0 96 96"
     shape-rendering="crispEdges" text-rendering="optimizeSpeed">
  <defs>
    <clipPath id="moon">
      <circle cx="46" cy="44" r="17"/>
    </clipPath>
  </defs>

  <!-- Terminal background, then the patch: frame-coloured rim, dark field -->
  <rect width="96" height="96" fill="@SURFACE@"/>
  <circle cx="48" cy="48" r="46" fill="@FRAME@"/>
  <circle cx="48" cy="48" r="42" fill="@BG@"/>
  <circle cx="48" cy="48" r="39.5" fill="none" stroke="@LINE@" stroke-width="1"/>

  <!-- Stars -->
  <g fill="@FG2@">
    <rect x="16" y="40" width="1" height="1"/>
    <rect x="30" y="17" width="1" height="1"/>
    <rect x="63" y="15" width="1" height="1"/>
    <rect x="83" y="50" width="1" height="1"/>
    <rect x="22" y="64" width="1" height="1"/>
    <rect x="69" y="70" width="1" height="1"/>
  </g>
  <g fill="@FG@">
    <rect x="76" y="24" width="1" height="3"/>
    <rect x="75" y="25" width="3" height="1"/>
    <rect x="21" y="27" width="1" height="3"/>
    <rect x="20" y="28" width="3" height="1"/>
  </g>

  <!-- The whole orbit, dashed; the moon covers its far side -->
  <g transform="rotate(-18 47 50)">
    <ellipse cx="47" cy="50" rx="36" ry="13" fill="none" stroke="@MUTED@" stroke-width="1" stroke-dasharray="2 2"/>
  </g>

  <!-- Moon: lit disc, craters, the shadow side -->
  <circle cx="46" cy="44" r="17" fill="@FG@"/>
  <g fill="@FG2@">
    <circle cx="39" cy="37" r="4"/>
    <circle cx="49" cy="52" r="3"/>
    <circle cx="37" cy="50" r="2"/>
    <circle cx="51" cy="34" r="2"/>
  </g>
  <circle cx="66" cy="38" r="19" fill="@FAINT@" clip-path="url(#moon)"/>

  <!-- Near side of the orbit: the trail, fading towards the past, and the rocket -->
  <g transform="rotate(-18 47 50)" fill="none">
    <path d="M 11.55 52.26 A 36 13 0 0 0 23.86 59.96" stroke="@ACCENT2@" stroke-width="1" opacity="0.45"/>
    <path d="M 23.86 59.96 A 36 13 0 0 0 50.14 62.95" stroke="@ACCENT2@" stroke-width="2" opacity="0.75"/>
    <path d="M 50.14 62.95 A 36 13 0 0 0 71.09 59.66" stroke="@ACCENT@" stroke-width="2"/>

    <g transform="translate(74.6 58.4) rotate(-23) scale(1.35)">
      <rect x="-12" y="-0.5" width="2" height="1" fill="@FG2@"/>
      <rect x="-10" y="-1" width="3" height="2" fill="@ACCENT@"/>
      <polygon points="-6,-2 -4,-2 -8,-5" fill="@ACCENT@"/>
      <polygon points="-6,2 -4,2 -8,5" fill="@ACCENT@"/>
      <rect x="-7" y="-2" width="10" height="4" fill="@FG@"/>
      <polygon points="3,-2 7,0 3,2" fill="@FG@"/>
      <rect x="-1" y="-1" width="2" height="2" fill="@ACCENT2@"/>
    </g>
  </g>

  <!-- Name tab on top -->
  <rect x="34.5" y="0.5" width="27" height="9" fill="@BG@" stroke="@FRAME@" stroke-width="1"/>
  <text x="48" y="7" text-anchor="middle" font-family="Silkscreen" font-size="8" fill="@FRAME@">T580</text>
</svg>
