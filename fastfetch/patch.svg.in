<!--
  fastfetch logo: the moon and a rocket flying around it, its trail fading
  behind it. Drawn on a 70x56 pixel grid without anti-aliasing;
  `station theme` fills in the colours (@...@), renders it with resvg,
  scales it up 5x with hard pixel edges (350x280 px = 25x10 cells of the
  22 px Departure Mono in foot) and turns it into sixel data.
-->
<svg xmlns="http://www.w3.org/2000/svg" width="70" height="56" viewBox="0 0 70 56"
     shape-rendering="crispEdges">
  <defs>
    <clipPath id="moon">
      <circle cx="32" cy="26" r="17"/>
    </clipPath>
  </defs>

  <!-- The terminal's background colour -->
  <rect width="70" height="56" fill="@SURFACE@"/>

  <!-- Moon: lit disc, craters, the shadow side -->
  <circle cx="32" cy="26" r="17" fill="@FG@"/>
  <g fill="@FG2@">
    <circle cx="25" cy="19" r="4"/>
    <circle cx="35" cy="34" r="3"/>
    <circle cx="23" cy="32" r="2"/>
    <circle cx="37" cy="16" r="2"/>
  </g>
  <circle cx="52" cy="20" r="19" fill="@FAINT@" clip-path="url(#moon)"/>

  <!-- The trail on the near side of the orbit, fading towards the past,
       and the rocket at its head -->
  <g transform="rotate(-18 33 30)" fill="none">
    <path d="M 3.46 31.91 A 30 11 0 0 0 13.72 38.43" stroke="@ACCENT2@" stroke-width="1" opacity="0.45"/>
    <path d="M 13.72 38.43 A 30 11 0 0 0 35.61 40.96" stroke="@ACCENT2@" stroke-width="2" opacity="0.75"/>
    <path d="M 35.61 40.96 A 30 11 0 0 0 53.07 38.17" stroke="@ACCENT@" stroke-width="2"/>

    <g transform="translate(56 37.1) rotate(-24) scale(1.35)">
      <rect x="-12" y="-0.5" width="2" height="1" fill="@FG2@"/>
      <rect x="-10" y="-1" width="3" height="2" fill="@ACCENT@"/>
      <polygon points="-6,-2 -4,-2 -8,-5" fill="@ACCENT@"/>
      <polygon points="-6,2 -4,2 -8,5" fill="@ACCENT@"/>
      <rect x="-7" y="-2" width="10" height="4" fill="@FG@"/>
      <polygon points="3,-2 7,0 3,2" fill="@FG@"/>
      <rect x="-1" y="-1" width="2" height="2" fill="@ACCENT2@"/>
    </g>
  </g>
</svg>
