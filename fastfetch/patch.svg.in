<!--
  fastfetch logo: a plain moon, lit side and shadow side, two craters.
  Drawn on a 36x36 pixel grid without anti-aliasing and with a transparent
  background; `station theme` fills in the colours (@...@), renders it with
  resvg and scales it up 7x with hard pixel edges to 252x252 px, exactly
  18x9 of foot's 14x28 px cells (22 px Departure Mono): as tall as the
  nine lines of text next to it.
-->
<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 36 36"
     shape-rendering="crispEdges">
  <defs>
    <clipPath id="moon">
      <circle cx="18" cy="18" r="15"/>
    </clipPath>
  </defs>

  <circle cx="18" cy="18" r="15" fill="@FG@"/>
  <g fill="@FG2@">
    <circle cx="12" cy="12" r="3"/>
    <circle cx="15" cy="24" r="2"/>
  </g>
  <circle cx="33" cy="12" r="16" fill="@FAINT@" clip-path="url(#moon)"/>
</svg>
