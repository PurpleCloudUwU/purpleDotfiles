+    /// Layer surfaces matched by `show-only-in "screencast"` cover monitor casts. A window cast
+    /// draws only the window, so draw them over it too, shifted so that the part of the cover
+    /// where the window is on the monitor lines up with the window.
+    fn render_cover_for_window_cast(
+        &self,
+        renderer: &mut GlesRenderer,
+        output: &Output,
+        mapped: &Mapped,
+        scale: Scale<f64>,
+        push: &mut dyn FnMut(CastRenderElement<GlesRenderer>),
+    ) {
+        let layer_map = layer_map_for_output(output);
+        let covers: Vec<_> = layer_map
+            .layers()
+            .filter_map(|surface| {
+                let layer = self.mapped_layer_surfaces.get(surface)?;
+                layer.covers(RenderTarget::Screencast).then_some(())?;
+                Some((layer, layer_map.layer_geometry(surface)?))
+            })
+            .collect();
+        if covers.is_empty() {
+            return;
+        }
+
+        // Where the window geometry is on the output (unknown when its workspace is not shown).
+        let mut pos = Point::<f64, Logical>::default();
+        self.layout.with_windows(|win, win_output, _, layout| {
+            if win.id() == mapped.id() && win_output == Some(output) {
+                if let Some((x, y)) = layout.tile_pos_in_workspace_view {
+                    let (dx, dy) = layout.window_offset_in_tile;
+                    pos = Point::from((x + dx, y + dy));
+                }
+            }
+        });
+        // The cast buffer starts at the window's bbox (popups included), see
+        // render_for_screen_cast().
+        let geo = mapped.window.geometry().loc.to_f64();
+        let bbox = mapped
+            .window
+            .bbox_with_popups()
+            .to_physical_precise_up(scale)
+            .to_logical(scale)
+            .loc;
+        let origin = pos - geo + bbox;
+
+        for (layer, layer_geo) in covers {
+            let ctx = RenderCtx {
+                renderer: &mut *renderer,
+                target: RenderTarget::Screencast,
+                xray: None,
+            };
+            let loc = layer_geo.loc.to_f64() - origin;
+            layer.render_normal(ctx, None, loc, XrayPos::default(), &mut |elem| {
+                push(CastRenderElement::from(OutputRenderElements::from(elem)))
+            });
+        }
+    }
+
