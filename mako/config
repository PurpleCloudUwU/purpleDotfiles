# Mako notifications, styled like fuzzel (Catppuccin Mocha, purple accent like Waybar/Sway).
# Colors as #RRGGBBAA, AA = opacity
# After changes: makoctl reload

font=JetBrainsMono Nerd Font 12
background-color=#0f0b14f2
text-color=#f0d7ffff
border-color=#be8cffff
progress-color=over #22192eff

border-size=1
border-radius=0
padding=14,20
margin=10
width=360
height=150

# App name small in the accent color (like the fuzzel prompt), title and body below
format=<span color="#be8cff">%a</span>\n<b>%s</b>\n%b

# mako's default is 0 = never hide
default-timeout=5000

# History for the Waybar bell (default: 5)
max-history=20
# Update the bell right away; the signal must match waybar/notifications.sh
on-notify=exec pkill -RTMIN+11 waybar

# Nerd Font icon before the app name for my own scripts
# (same icons as in the history, see glyph_for in waybar/notifications.sh)
[app-name=Wi-Fi]
format=<span color="#be8cff">󰖩  %a</span>\n<b>%s</b>\n%b

[app-name=Bluetooth]
format=<span color="#be8cff">󰂯  %a</span>\n<b>%s</b>\n%b

[app-name="Power Profile"]
format=<span color="#be8cff">󰓅  %a</span>\n<b>%s</b>\n%b

[app-name=Audio]
format=<span color="#be8cff">󰓃  %a</span>\n<b>%s</b>\n%b

[urgency=low]
border-color=#62597eff

[urgency=critical]
border-color=#ff50dcff
default-timeout=0
