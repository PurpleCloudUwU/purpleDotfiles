; Minimal desktop widgets around the angel in the middle of the wallpaper.
; The angel spans roughly y=440..700 on 1920x1080, so the clock sits above it
; and "now playing" below it.

(defpoll time :interval "5s" "date +%H:%M")

; playerctl prints an empty line when the player stops, which hides the widget
(deflisten music :initial ""
  "playerctl --follow metadata --format '{{ artist }} — {{ title }}' 2>/dev/null || true")

; Time between two thin lines (weekday and date are in the Waybar)
(defwidget clock []
  (box :class "clock" :space-evenly false :halign "center" :valign "center"
    (box :class "rule" :valign "center")
    (label :class "time" :text time)
    (box :class "rule" :valign "center")))

(defwidget music []
  (label :class "music" :visible {music != ""} :limit-width 60
         :text "♪  ${music}"))

; Spotify player in the bottom right corner, hidden while Spotify isn't running
(deflisten sp :initial '{"status":"","artist":"","title":""}'
  "~/.config/eww/spotify.sh")
(defpoll sppos :interval "1s" :run-while {sp.title != ""}
  :initial '{"time":"0:00","total":"0:00","bar":""}'
  "~/.config/eww/spotify-pos.sh")

; Mirror of the stats in the bottom left: three right-aligned lines with the
; time, a text progress bar and the controls (title and artist are already in
; "now playing" below the angel)
(defwidget player []
  (box :class "player" :orientation "v" :space-evenly false :halign "end"
       :visible {sp.title != ""}
    (label :class "time" :halign "end" :text "${sppos.time} / ${sppos.total}")
    (label :class "bar" :halign "end" :text {sppos.bar})
    (box :class "controls" :space-evenly false :spacing 12 :halign "end"
      (button :onclick "playerctl -p spotify previous" "󰒮")
      (button :onclick "playerctl -p spotify play-pause"
        {sp.status == "Playing" ? "󰏤" : "󰐊"})
      (button :onclick "playerctl -p spotify next" "󰒭"))))

(defwidget stats []
  (box :class "stats" :orientation "v" :space-evenly false :halign "start"
    (label :halign "start" :text "cpu  ${round(EWW_CPU.avg, 0)}%")
    (label :halign "start" :text "ram  ${round(EWW_RAM.used_mem_perc, 0)}%")
    (label :halign "start" :text "/    ${round(EWW_DISK["/"].used_perc, 0)}%")))

(defwindow clock
  :monitor 0
  :geometry (geometry :anchor "top center" :y "110px" :width "900px" :height "300px")
  :stacking "bottom"
  :exclusive false
  :focusable false
  (clock))

(defwindow music
  :monitor 0
  :geometry (geometry :anchor "top center" :y "780px" :width "800px" :height "30px")
  :stacking "bottom"
  :exclusive false
  :focusable false
  (music))

(defwindow stats
  :monitor 0
  :geometry (geometry :anchor "bottom left" :x "40px" :y "40px" :width "200px" :height "70px")
  :stacking "bottom"
  :exclusive false
  :focusable false
  (stats))

; Same position and height as the stats, mirrored; wider for the progress bar
(defwindow player
  :monitor 0
  :geometry (geometry :anchor "bottom right" :x "40px" :y "40px" :width "300px" :height "70px")
  :stacking "bottom"
  :exclusive false
  :focusable false
  (player))

; nf-md-fingerprint while fprintd waits for a finger (sudo, polkit),
; opened and closed by fingerprint.sh
(defwindow fingerprint
  :monitor 0
  :geometry (geometry :anchor "bottom right" :x "32px" :y "32px" :width "72px" :height "72px")
  :stacking "overlay"
  :exclusive false
  :focusable false
  ; fixed size: the glyph is wider than its advance width and got cut off
  (label :class "fingerprint" :halign "center" :valign "center" :text "󰈷"))
