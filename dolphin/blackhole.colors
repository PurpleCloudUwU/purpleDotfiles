# KDE color scheme matching Sway/Waybar/fuzzel/mako (Catppuccin Mocha, accent #be8cff).
# Colors as R,G,B. Enabled in Dolphin via ~/.config/dolphinrc -> [UiSettings] ColorScheme=blackhole
#
# Palette:
#   #08060a crust   #0b080f mantle   #0f0b14 base   #22192e surface0   #332645 surface1
#   #756b95 overlay1   #ffffff text   #be8cff accent   #c8b9ff mauve
#   #f38ba8 red   #f9e2af yellow   #a6e3a1 green

[ColorEffects:Disabled]
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=112,111,110
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

