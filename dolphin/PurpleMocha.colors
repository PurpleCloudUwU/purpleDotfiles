# Palette:
#   #11111b crust   #181825 mantle   #1e1e2e base   #313244 surface0   #45475a surface1
#   #7f849c overlay1   #ffffff Schrift   #b794f6 Akzent   #cba6f7 mauve
#   #f38ba8 rot   #f9e2af gelb   #a6e3a1 gruen

