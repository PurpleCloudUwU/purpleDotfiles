# KDE-Farbschema passend zu Sway/Waybar/fuzzel/mako (Catppuccin Mocha, Akzent #b794f6).
# Farben als R,G,B. Aktiv in Dolphin ueber ~/.config/dolphinrc -> [UiSettings] ColorScheme=PurpleMocha
