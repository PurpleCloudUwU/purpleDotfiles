#!/usr/bin/env bash
# station: colour worlds and the CRT screen of the Mondbasis rice.
#
#   station theme                       show the current theme
#   station theme <name>|next           amber, red, green, violet, or the next one
#   station crt                         show the CRT settings
#   station crt <preset>                off, work, subtle, full
#   station crt toggle                  off <-> the last preset (Super+F12)
#   station crt tint <tint>             neutral, amber, green, red
#   station crt set <key> <0-100>       scan, curve, glow, fringe, vig, noise, flick
#                                       (the preset becomes "custom")
#   station crt option <name> <on|off>  battery_subtle, fullscreen_off
#   station crt apply [preset]          apply the saved settings again, or show a
#                                       preset without saving it (Quickshell uses
#                                       this on battery and for fullscreen windows)
#   station bright <up|down|0-100>      screen brightness, shows the OSD
#   station open <what>                 terminal, files, editor, monitor, music,
#                                       player, browser, crt
#   station shot <screen|region|window> screenshot to ~/Pictures/Screenshots
#   station battery                     charge of all batteries together
#   station power <lock|logout|suspend|reboot|off>
#   station init                        write all generated files (install.sh)
#
# Palettes come from ~/.config/station/palettes/<name>.conf, everything this
# script writes goes to ~/.local/state/station/ (plus yazi's theme.toml and
# btop's theme, which have to live in their config folders).
set -euo pipefail

conf=${XDG_CONFIG_HOME:-$HOME/.config}
home=$conf/station
state=${XDG_STATE_HOME:-$HOME/.local/state}/station

themes=(amber red green violet)
crt_keys=(scan curve glow fringe vig noise flick)
# Values in crt_keys order, 0-100. Curvature and flicker need a full redraw
# every frame, so only "full" uses them (it costs noticeable battery).
declare -A crt_presets=(
    [off]="0 0 0 0 0 0 0"
    [work]="20 0 25 5 20 0 0"
    [subtle]="35 0 40 15 30 8 0"
    [full]="85 60 75 55 70 35 20"
)
declare -A crt_tints=(
    [neutral]="1.0, 1.0, 1.0"
    [amber]="1.0, 0.82, 0.48"
    [green]="0.55, 1.0, 0.6"
    [red]="1.0, 0.5, 0.42"
)

die() { printf 'station: %s\n' "$*" >&2; exit 1; }
usage() { sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed '$d; s/^# \{0,1\}//'; }
in_hyprland() { [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v hyprctl >/dev/null; }
# Tells Quickshell to re-read the state files (it also watches them)
ping_shell() { command -v qs >/dev/null && qs ipc call station refresh >/dev/null 2>&1 || true; }

mkdir -p "$state/crt"

# --- Palettes ---------------------------------------------------------------

declare -A P
load_palette() {
    local file=$home/palettes/$1.conf k v
    [[ -f $file ]] || die "unknown theme '$1' (${themes[*]})"
    P=()
    while IFS='=' read -r k v; do
        if [[ $k =~ ^[a-z0-9_]+$ ]]; then P[$k]=$v; fi
    done < "$file"
}

current_theme() {
    local t
    t=$(cat "$state/theme" 2>/dev/null || true)
    echo "${t:-violet}"
}

hex() { echo "${P[$1]#\#}"; }
rgb() {
    local h=${P[$1]#\#}
    printf '%d;%d;%d' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"
}

render_foot() {
    local i
    {
        echo "# Generated by 'station theme' from palettes/$1.conf"
        echo "[colors-dark]"
        echo "background=$(hex surface)"
        echo "foreground=$(hex fg)"
        for i in 0 1 2 3 4 5 6 7; do echo "regular$i=$(hex "color$i")"; done
        for i in 0 1 2 3 4 5 6 7; do echo "bright$i=$(hex "color$((i + 8))")"; done
        echo "selection-foreground=$(hex bg)"
        echo "selection-background=$(hex frame)"
        echo "cursor=$(hex surface) $(hex frame)"
        echo "urls=$(hex accent)"
    } > "$state/foot-colors.ini"
}

# user@host in the accent colour, the path dimmed, like on the canvas
render_prompt() {
    cat > "$state/prompt.sh" <<EOF
# Generated by 'station theme'
PS1='\[\e[38;2;$(rgb accent)m\]\u@\h\[\e[0m\] \[\e[38;2;$(rgb muted)m\]\w\[\e[0m\] \\\$ '
EOF
}

render_hyprlock() {
    cat > "$state/hyprlock-colors.conf" <<EOF
# Generated by 'station theme' from palettes/$1.conf
\$bg = rgb($(hex bg))
\$surface = rgb($(hex surface))
\$line = rgb($(hex line))
\$fg = rgb($(hex fg))
\$muted = rgb($(hex muted))
\$frame = rgb($(hex frame))
\$accent = rgb($(hex accent))
EOF
}

render_yazi() {
    [[ -d $conf/yazi ]] || return 0
    local bg=${P[bg]} fg=${P[fg]} fg2=${P[fg2]} muted=${P[muted]} line=${P[line]}
    local frame=${P[frame]} accent=${P[accent]} s2=${P[surface2]}
    cat > "$conf/yazi/theme.toml" <<EOF
# Generated by 'station theme' from palettes/$1.conf, edits get overwritten.
# Change ~/.config/station/palettes/ or the render_yazi function instead.

[mgr]
cwd = { fg = "$fg" }
find_keyword  = { fg = "$accent", bold = true }
find_position = { fg = "$accent", bg = "reset" }
marker_copied   = { fg = "$fg2", bg = "$fg2" }
marker_cut      = { fg = "$accent", bg = "$accent" }
marker_marked   = { fg = "$frame", bg = "$frame" }
marker_selected = { fg = "$accent", bg = "$accent" }
count_copied   = { fg = "$bg", bg = "$fg2" }
count_cut      = { fg = "$bg", bg = "$accent" }
count_selected = { fg = "$bg", bg = "$frame" }
border_symbol = "│"
border_style  = { fg = "$line" }

[tabs]
active   = { fg = "$bg", bg = "$frame" }
inactive = { fg = "$muted", bg = "$s2" }

[mode]
normal_main = { fg = "$bg", bg = "$frame" }
normal_alt  = { fg = "$fg", bg = "$s2" }
select_main = { fg = "$bg", bg = "$accent" }
select_alt  = { fg = "$fg", bg = "$s2" }
unset_main  = { fg = "$bg", bg = "$accent" }
unset_alt   = { fg = "$fg", bg = "$s2" }

[indicator]
parent  = { fg = "$fg", bg = "$s2" }
current = { fg = "$bg", bg = "$frame" }
preview = { underline = true }

[status]
perm_sep   = { fg = "$line" }
perm_type  = { fg = "$fg" }
perm_read  = { fg = "$muted" }
perm_write = { fg = "$accent" }
perm_exec  = { fg = "$fg2" }
progress_label  = { fg = "$fg", bold = true }
progress_normal = { fg = "$frame", bg = "$s2" }
progress_error  = { fg = "$accent", bg = "$s2" }

[which]
border = { fg = "$frame" }
cand   = { fg = "$frame" }
rest   = { fg = "$muted" }
desc   = { fg = "$fg" }
separator_style = { fg = "$line" }

[confirm]
border = { fg = "$frame" }
title  = { fg = "$frame" }

[spot]
border   = { fg = "$frame" }
title    = { fg = "$frame" }
tbl_col  = { fg = "$frame" }
tbl_cell = { fg = "$accent", reversed = true }

[notify]
title_info  = { fg = "$frame" }
title_warn  = { fg = "$accent" }
title_error = { fg = "$accent" }

[pick]
border = { fg = "$frame" }
active = { fg = "$accent", bold = true }

[input]
border = { fg = "$frame" }

[cmp]
border = { fg = "$frame" }

[tasks]
border  = { fg = "$frame" }
hovered = { fg = "$accent" }

[help]
border  = { fg = "$frame" }
chord   = { fg = "$accent" }
hovered = { fg = "$bg", bg = "$frame" }

[filetype]
rules = [
    { url = "*", is = "orphan", fg = "$accent" },
    { url = "*", is = "exec", fg = "$fg2" },
    { url = "*/", fg = "$fg" },
    { url = "*", fg = "$muted" },
]

# One plain folder and one plain file glyph instead of the colourful icon set
[icon]
globs = []
dirs  = []
files = []
exts  = []
conds = [
    { if = "dir", text = "" },
    { if = "!dir", text = "" },
]
EOF
}

render_btop() {
    mkdir -p "$conf/btop/themes"
    local bg=${P[bg]} fg=${P[fg]} fg2=${P[fg2]} muted=${P[muted]} line=${P[line]} off=${P[off]}
    local border=${P[border]} frame=${P[frame]} accent=${P[accent]} accent2=${P[accent2]}
    cat > "$conf/btop/themes/station.theme" <<EOF
# Generated by 'station theme' from palettes/$1.conf
theme[main_bg]=""
theme[main_fg]="$fg"
theme[title]="$fg"
theme[hi_fg]="$accent"
theme[selected_bg]="$frame"
theme[selected_fg]="$bg"
theme[inactive_fg]="$muted"
theme[graph_text]="$muted"
theme[meter_bg]="$off"
theme[proc_misc]="$fg2"
theme[cpu_box]="$border"
theme[mem_box]="$border"
theme[net_box]="$border"
theme[proc_box]="$border"
theme[div_line]="$line"
theme[temp_start]="$fg2"
theme[temp_mid]="$frame"
theme[temp_end]="$accent"
theme[cpu_start]="$accent2"
theme[cpu_mid]="$frame"
theme[cpu_end]="$accent"
theme[free_start]="$muted"
theme[free_mid]="$fg2"
theme[free_end]="$fg"
theme[cached_start]="$muted"
theme[cached_mid]="$fg2"
theme[cached_end]="$frame"
theme[available_start]="$muted"
theme[available_mid]="$fg2"
theme[available_end]="$fg"
theme[used_start]="$fg2"
theme[used_mid]="$frame"
theme[used_end]="$accent"
theme[download_start]="$muted"
theme[download_mid]="$accent2"
theme[download_end]="$frame"
theme[upload_start]="$muted"
theme[upload_mid]="$fg2"
theme[upload_end]="$accent"
theme[process_start]="$fg2"
theme[process_mid]="$frame"
theme[process_end]="$accent"
EOF
}

# fastfetch has no includes, so its config is made from config.jsonc.in
render_fastfetch() {
    local tpl=$conf/fastfetch/config.jsonc.in
    [[ -f $tpl ]] || return 0
    sed -e "s/@FG@/${P[fg]}/g" -e "s/@FG2@/${P[fg2]}/g" -e "s/@MUTED@/${P[muted]}/g" \
        -e "s/@FAINT@/${P[faint]}/g" -e "s/@BORDER@/${P[border]}/g" -e "s/@ACCENT@/${P[accent]}/g" \
        -e "s/@FRAME@/${P[frame]}/g" "$tpl" > "$conf/fastfetch/config.jsonc"
}

render_theme() {
    render_foot "$1"
    render_prompt
    render_hyprlock "$1"
    render_yazi "$1"
    render_btop "$1"
    render_fastfetch
}

# Recolours terminals that are already open (OSC 4/10/11/12, like pywal)
recolor_terminals() {
    local seq="" i t
    for i in {0..15}; do seq+="\e]4;$i;${P[color$i]}\a"; done
    seq+="\e]10;${P[fg]}\a\e]11;${P[surface]}\a\e]12;${P[frame]}\a"
    for t in /dev/pts/[0-9]*; do
        [[ -O $t && -w $t ]] && { printf '%b' "$seq" > "$t"; } 2>/dev/null || true
    done
}

theme_set() {
    local name=$1 cur i
    if [[ $name == next ]]; then
        cur=$(current_theme)
        name=${themes[0]}
        for i in "${!themes[@]}"; do
            [[ ${themes[$i]} == "$cur" ]] && name=${themes[$(( (i + 1) % ${#themes[@]} ))]}
        done
    fi
    load_palette "$name"
    echo "$name" > "$state/theme"
    render_theme "$name"
    if in_hyprland; then
        hyprctl reload >/dev/null || true   # window borders, hyprland.lua reads the theme
        recolor_terminals
    fi
    ping_shell
    echo "theme: $name"
}

# --- CRT ---------------------------------------------------------------------

declare -A C V
crt_load() {
    local k v i=0 vals
    C=([preset]=subtle [last]=subtle [tint]=neutral [battery_subtle]=on [fullscreen_off]=on [shader]="" [full_redraw]=0)
    read -ra vals <<< "${crt_presets[subtle]}"
    for k in "${crt_keys[@]}"; do C[$k]=${vals[i++]}; done
    [[ -f $state/crt.conf ]] || return 0
    while IFS='=' read -r k v; do
        if [[ $k =~ ^[a-z_]+$ ]]; then C[$k]=$v; fi
    done < "$state/crt.conf"
}

# Written in place (not renamed) so Quickshell's file watch keeps working
crt_save() {
    local k
    {
        echo "# Written by 'station crt'. Hyprland reads shader and full_redraw when it (re)loads."
        for k in preset last tint "${crt_keys[@]}" battery_subtle fullscreen_off shader full_redraw; do
            echo "$k=${C[$k]}"
        done
    } > "$state/crt.conf"
}

# Puts the values of a preset into V ("custom" takes them from C)
crt_values() {
    local k i=0 vals
    if [[ $1 == custom ]]; then
        for k in "${crt_keys[@]}"; do V[$k]=${C[$k]}; done
        return
    fi
    [[ -n ${crt_presets[$1]:-} ]] || die "unknown preset '$1' (off, work, subtle, full)"
    read -ra vals <<< "${crt_presets[$1]}"
    for k in "${crt_keys[@]}"; do V[$k]=${vals[i++]}; done
}

frac() { printf '%d.%02d' $(( $1 / 100 )) $(( $1 % 100 )); }
needs_redraw() { (( V[curve] > 0 || V[flick] > 0 )) && echo 1 || echo 0; }

# Writes the shader for V and the tint $1 and prints its path, or nothing when
# there is nothing to draw. The file name depends on the values, so Hyprland
# always sees a new path and recompiles.
crt_render() {
    local tint=$1 tpl=$home/crt/crt.frag.in key k sum=0 mix=0.00 use_time=0 id out
    [[ -n ${crt_tints[$tint]:-} ]] || die "unknown tint '$tint' (neutral, amber, green, red)"
    [[ -f $tpl ]] || die "missing $tpl"
    key=$tint
    for k in "${crt_keys[@]}"; do key+=" ${V[$k]}"; sum=$(( sum + V[$k] )); done
    [[ $tint != neutral ]] && mix=0.22
    (( sum == 0 )) && [[ $tint == neutral ]] && return 0
    (( V[flick] > 0 )) && use_time=1
    id=$({ echo "$key"; cat "$tpl"; } | cksum | cut -d' ' -f1)
    out=$state/crt/crt-$id.frag
    if [[ ! -f $out ]]; then
        sed -e "s/@USE_TIME@/$use_time/" \
            -e "s/@SCAN@/$(frac "${V[scan]}")/" -e "s/@CURVE@/$(frac "${V[curve]}")/" \
            -e "s/@GLOW@/$(frac "${V[glow]}")/" -e "s/@FRINGE@/$(frac "${V[fringe]}")/" \
            -e "s/@VIG@/$(frac "${V[vig]}")/" -e "s/@NOISE@/$(frac "${V[noise]}")/" \
            -e "s/@FLICK@/$(frac "${V[flick]}")/" \
            -e "s/@TINT@/${crt_tints[$tint]}/" -e "s/@TINT_MIX@/$mix/" \
            "$tpl" > "$out.tmp"
        mv "$out.tmp" "$out"
    fi
    echo "$out"
}

# Sends a shader to the running Hyprland. Damage tracking goes off only for
# curvature and flicker, everything else keeps the cheap partial redraws.
crt_push() {
    local shader=$1 dt=2
    in_hyprland || return 0
    [[ $2 == 1 ]] && dt=0
    hyprctl eval "hl.config({ debug = { damage_tracking = $dt } }) hl.config({ decoration = { screen_shader = [[$shader]] } })" >/dev/null ||
        echo "station: hyprctl eval failed, the shader is used after the next Hyprland reload" >&2
}

# Removes generated shaders that are neither saved nor just applied
crt_cleanup() {
    local f
    for f in "$state"/crt/crt-*.frag; do
        if [[ -e $f && $f != "${C[shader]}" && $f != "${1:-}" ]]; then rm -f "$f"; fi
    done
}

# Saves V as the current settings and applies them
crt_commit() {
    local k
    for k in "${crt_keys[@]}"; do C[$k]=${V[$k]}; done
    C[shader]=$(crt_render "${C[tint]}")
    C[full_redraw]=$(needs_redraw)
    crt_save
    crt_cleanup
    crt_push "${C[shader]}" "${C[full_redraw]}"
    ping_shell
    crt_show
}

crt_show() {
    local k
    printf 'crt › preset=%s  tint=%s' "${C[preset]^^}" "${C[tint]^^}"
    for k in "${crt_keys[@]}"; do printf '  %s=%s' "$k" "${C[$k]}"; done
    printf '\n'
}

crt_cmd() {
    crt_load
    local arg=${1:-}
    case $arg in
        "")
            crt_show ;;
        off|work|subtle|full)
            crt_values "$arg"
            C[preset]=$arg
            [[ $arg != off ]] && C[last]=$arg
            crt_commit ;;
        toggle)
            if [[ ${C[preset]} == off ]]; then
                C[preset]=${C[last]:-subtle}
                [[ ${C[preset]} == off ]] && C[preset]=subtle
            else
                C[preset]=off
            fi
            crt_values "${C[preset]}"
            crt_commit ;;
        tint)
            [[ -n ${crt_tints[${2:-}]:-} ]] || die "usage: station crt tint <neutral|amber|green|red>"
            C[tint]=$2
            crt_values "${C[preset]}"
            crt_commit ;;
        set)
            [[ " ${crt_keys[*]} " == *" ${2:-} "* ]] || die "usage: station crt set <${crt_keys[*]}> <0-100>"
            [[ ${3:-} =~ ^[0-9]+$ ]] && (( $3 <= 100 )) || die "the value has to be 0-100"
            crt_values "${C[preset]}"
            V[$2]=$3
            C[preset]=custom
            C[last]=custom
            crt_commit ;;
        option)
            [[ ${2:-} == battery_subtle || ${2:-} == fullscreen_off ]] || die "usage: station crt option <battery_subtle|fullscreen_off> <on|off>"
            [[ ${3:-} == on || ${3:-} == off ]] || die "the option is either on or off"
            C[$2]=$3
            crt_save
            ping_shell ;;
        apply)
            if [[ -n ${2:-} && $2 != "${C[preset]}" ]]; then
                # Show another preset without saving it
                local shader
                crt_values "$2"
                shader=$(crt_render "${C[tint]}")
                crt_cleanup "$shader"
                crt_push "$shader" "$(needs_redraw)"
            else
                crt_values "${C[preset]}"
                if [[ -n ${C[shader]} && ! -f ${C[shader]} ]] || [[ -z ${C[shader]} && ${C[preset]} != off ]]; then
                    C[shader]=$(crt_render "${C[tint]}")
                    C[full_redraw]=$(needs_redraw)
                    crt_save
                fi
                crt_cleanup
                crt_push "${C[shader]}" "${C[full_redraw]}"
            fi ;;
        *)
            die "unknown crt command '$arg' (see station --help)" ;;
    esac
}

# --- Programs, screenshots, brightness, power ---------------------------------

# One place that knows which program does what (Hyprland binds and the
# program select both use it)
open_app() {
    local entry f
    case ${1:-} in
        terminal) exec foot ;;
        files)    exec foot --app-id=station.files yazi ;;
        editor)   exec foot --app-id=station.editor nvim ;;
        monitor)  exec foot --app-id=station.monitor btop ;;
        player)   exec foot --app-id=kew kew ;;
        music)
            command -v spotify-launcher >/dev/null && exec spotify-launcher
            command -v spotify >/dev/null && exec spotify
            exec foot --app-id=kew kew ;;
        browser)
            entry=$(xdg-settings get default-web-browser 2>/dev/null || true)
            if [[ -n $entry ]]; then
                for f in "${XDG_DATA_HOME:-$HOME/.local/share}/applications/$entry" "/usr/share/applications/$entry"; do
                    if [[ -f $f ]]; then exec gio launch "$f"; fi
                done
            fi
            for f in librewolf firefox brave-origin chromium; do
                if command -v "$f" >/dev/null; then exec "$f"; fi
            done
            die "no browser found" ;;
        # Until the CRT calibration app exists, the PDA panel has the presets
        crt) exec qs ipc call quick open ;;
        *) die "usage: station open <terminal|files|editor|monitor|music|player|browser|crt>" ;;
    esac
}

shot() {
    local dir=${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots file geo
    [[ ${1:-screen} =~ ^(screen|region|window)$ ]] || die "usage: station shot <screen|region|window>"
    mkdir -p "$dir"
    file=$dir/$(date +%Y-%m-%d_%H%M%S).png
    case ${1:-screen} in
        screen) grim "$file" ;;
        region) geo=$(slurp) || exit 0; grim -g "$geo" "$file" ;;
        window)
            geo=$(hyprctl -j activewindow | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"') || die "no active window"
            grim -g "$geo" "$file" ;;
        *) die "usage: station shot <screen|region|window>" ;;
    esac
    if command -v wl-copy >/dev/null; then wl-copy < "$file"; fi
    if command -v notify-send >/dev/null; then notify-send -a station "Screenshot saved" "${file/#"$HOME"/\~}"; fi
}

# The T580 has an internal and an external battery
battery() {
    local now=0 full=0 b
    for b in /sys/class/power_supply/BAT*; do
        [[ -r $b/energy_now && -r $b/energy_full ]] || continue
        now=$(( now + $(<"$b/energy_now") ))
        full=$(( full + $(<"$b/energy_full") ))
    done
    if (( full > 0 )); then echo "BAT $(( now * 100 / full )) %"; else echo "BAT --"; fi
}

bright() {
    local pct
    command -v brightnessctl >/dev/null || die "brightnessctl is not installed"
    case ${1:-} in
        up)   brightnessctl -q -n1 set 5%+ ;;
        down) brightnessctl -q -n1 set 5%- ;;
        [0-9]|[0-9][0-9]|100) brightnessctl -q -n1 set "$1%" ;;
        *)    die "usage: station bright <up|down|0-100>" ;;
    esac
    pct=$(brightnessctl -m | cut -d, -f4)
    command -v qs >/dev/null && qs ipc call osd brightness "${pct%\%}" >/dev/null 2>&1 || true
}

power() {
    case ${1:-} in
        lock)    loginctl lock-session ;;
        logout)
            if command -v hyprshutdown >/dev/null; then hyprshutdown
            else hyprctl dispatch 'hl.dsp.exit()'; fi ;;
        suspend) systemctl suspend ;;
        reboot)  systemctl reboot ;;
        off)     systemctl poweroff ;;
        *)       die "usage: station power <lock|logout|suspend|reboot|off>" ;;
    esac
}

init() {
    local t
    [[ -f $state/theme ]] || echo violet > "$state/theme"
    t=$(current_theme)
    load_palette "$t"
    render_theme "$t"
    crt_load
    crt_values "${C[preset]}"
    C[shader]=$(crt_render "${C[tint]}")
    C[full_redraw]=$(needs_redraw)
    crt_save
    crt_cleanup
    echo "theme: $t"
    crt_show
}

case ${1:-} in
    theme)
        shift
        if (($#)); then theme_set "$1"; else current_theme; fi ;;
    crt)    shift; crt_cmd "$@" ;;
    bright) shift; bright "$@" ;;
    open)   shift; open_app "$@" ;;
    shot)   shift; shot "$@" ;;
    battery) battery ;;
    power)  shift; power "$@" ;;
    init)   init ;;
    ""|-h|--help|help) usage ;;
    *) die "unknown command '$1' (see station --help)" ;;
esac
