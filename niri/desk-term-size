#!/usr/bin/env python3
"""New windows in yami's desk mode open floating at the terminal's size.

niri opens every window tiled; in desk mode yami then makes it floating, so a
window would first show up tall in the tiling and then jump. Instead this
keeps a niri window rule in ~/.local/state/desk-mode.kdl (included at the end
of niri/user.kdl): in desk mode it opens every window floating at the size a
terminal had when one was last resized by hand; in tiling mode the file
holds no rule. Left out are windows that bring their own size and place
(EXCLUDE: picture-in-picture, file dialogs, photo and video viewers, games).

niri places a window that opens floating in the middle of the screen. Each
further window on the same workspace is moved 1 % of the screen further up
and right from there (STEP); the count starts again on an empty workspace,
and from the middle once the next step would push a window off the screen.

The same file switches focus-follows-mouse: on in tiling mode, off in desk
mode, where a click focuses and raises a window. With it on, hovering
focused a window without raising it, and yami, which draws the title bars
for the focused window as the top one, put titles over the windows in front.
niri cannot switch the setting off in a later file, so install.sh comments
it out of yami's config.kdl and it is only set here. The file is rewritten
when the mode changes (yami writes ~/.local/state/yami/stacking) and when the
size changes, then niri reloads.

Switching tiling → desk: yami makes every window floating, and niri keeps a
window that never floated at its tiled size and place (full height, side by
side), so it still looks tiled. Such windows (nearly as tall as the screen)
get a window size here: terminals the saved one, others 60 % × 70 % of the
screen; they are centred, each one a little further down and right, so every
title bar stays visible. Windows that floated before keep their size and
place. (The order yami floats them in is fixed by yami/patches/0002.)

The other way round (desk → tiling, or Mod+G), niri makes the column as wide
as the floating window was, so two terminals together were wider than the
screen. A window that turns tiled gets the default column width instead,
a moment later and only if it is not maximized: maximizing a floating
window (yami's title bar button or double click, maximize-window-to-edges)
turns it tiled too, and that one should stay as large as the screen.

In desk mode a maximized window must not turn tiled, though: niri always
draws floating windows above tiled ones, so the other windows lay on top
of it. So it is floated again right away and made as large as the screen
(below the bar), which keeps it in the floating layer, where focus raises
it. Maximizing it again (title bar, Mod+F) tiles it once more; that is
caught the same way and gives it back its old size and place.
niri keeps the view scrolled as it was for the wider columns, so shortly
after desk → tiling the focus goes to the last column, the first and back:
niri scrolls only as far as needed each time, which leaves the view
starting at the left edge.

yami turns only the windows it floated itself back into tiles when desk mode
is switched off, so the terminals floated by the rule are tiled again here.

The size is kept in ~/.local/state/desk-term-size.json, so it survives
logging out; editing that file by hand works too. A size counts only when a
floating terminal is resized by hand: changes right after a window turned
floating or tiled (desk ↔ tiling, Mod+G), the ones made here and a window as
large as a screen (fullscreen) are left out.

Fallback: a window that still opens tiled in desk mode (opened in the
moment desk mode was switched on, before the rule is written) is sized and
placed once yami has floated it.

Started by niri (niri/user.kdl, spawn-sh-at-startup); ends with niri.
"""
import json
import os
import re
import select
import socket
import sys
import time
from pathlib import Path

APPS = {"kitty"}    # app ids that count as the terminal (their size is the one kept)
SETTLE = 1.0        # s after a floating change or a resize from here: not by hand
PENDING = 5.0       # s a new terminal may take to turn floating
SAVE_AFTER = 0.5    # s without further resizing before the size is written
CENTER = 1.0        # s after the fallback in which a size change centres again
POLL = 0.3          # s between looks at the mode and size files
TALL = 0.85         # a floating window this much of the screen high still has its tiled shape
DESK_SIZE = (0.6, 0.7)  # share of the screen such a window gets (terminals: the saved size)
CASCADE = 32        # px each further window moves down and right
STEP = 0.01         # share of the screen each further new window opens up and right
STEP_ROOM = 48      # px kept free above a stepped window (bar and yami's title bar)
TILE_WIDTH = 50.0   # % column width a window gets when it turns tiled (yami's default-column-width)
RETILE_AFTER = 0.3  # s after a window turned tiled before it gets the default width
RETILE_DESK = 1.0   # the same in desk mode, where it may still turn out maximized (slow apps)
MAXIMIZED = 0.95    # a tiled window this much of the screen wide counts as maximized
REFIT_AFTER = 0.6   # s after desk → tiling before the view is scrolled to fit

STATE = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
SIZE_FILE = STATE / "desk-term-size.json"
RULE_FILE = STATE / "desk-mode.kdl"   # included by niri/user.kdl
FOCUS_FOLLOWS_MOUSE = 'focus-follows-mouse max-scroll-amount="0%"'   # as yami had it
DESK_FILE = STATE / "yami/stacking"   # yami writes 1 in desk mode, 0 in tiling

# Windows the desk mode rule leaves alone, as niri `exclude` lines (all keys
# of one entry must match): they have a size and place of their own in
# yami's config.kdl and yami-fx.kdl.
EXCLUDE = [
    {"title": r"^(Picture-in-Picture|Картинка в картинке)$"},
    {"title": r"^(Open|Save|Открыть|Сохранить)( File| As| файл| как)?"},
    {"app-id": r"^xdg-desktop-portal"},
    {"app-id": r"^yami-files-pick$"},
    {"app-id": r"^(yami-view|yami-play|imv|feh|n?sxiv|swayimg|qimgv|mpv|vlc)$"},
    {"app-id": r"^org\.(gnome\.(Loupe|eog|Showtime)|kde\.gwenview)$"},
    {"app-id": r"(?i)(telegram|ayugram|64gram|kotatogram)",
     "title": r"^(Media viewer|Просмотр медиа|Медиапросмотрщик)$"},
    {"app-id": r"^steam_app_"},
    {"app-id": r"^gamescope$"},
]


def excluded(w):
    """True for a window the desk mode rule leaves alone (as niri matches: search, not full match)."""
    have = {"app-id": w.get("app_id") or "", "title": w.get("title") or ""}
    return any(all(re.search(rx, have[k]) for k, rx in e.items()) for e in EXCLUDE)


def request(req):
    with socket.socket(socket.AF_UNIX) as s:
        s.connect(os.environ["NIRI_SOCKET"])
        s.sendall((json.dumps(req) + "\n").encode())
        return json.loads(s.makefile().readline())


def desk_mode():
    try:
        return DESK_FILE.read_text().strip() == "1"
    except OSError:
        return False


def load_size():
    try:
        d = json.loads(SIZE_FILE.read_text())
        return int(d["width"]), int(d["height"])
    except (OSError, ValueError, KeyError, TypeError):
        return None


def write_atomic(path, text):
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


def save_size(size):
    write_atomic(SIZE_FILE, json.dumps({"width": size[0], "height": size[1]}) + "\n")


def stamp():
    """What the mode and size files look like now, to notice changes."""
    out = []
    for f in (DESK_FILE, SIZE_FILE):
        try:
            st = f.stat()
            out.append((st.st_mtime_ns, st.st_size))
        except OSError:
            out.append(None)
    return out


def rule_text(desk, size):
    head = "// written by desk-term-size (purpleDotfiles/niri); changes are overwritten\n"
    if not desk:
        return head + "// tiling mode\ninput {\n    " + FOCUS_FOLLOWS_MOUSE + "\n}\n"
    # no match line: the rule is for every window but the excluded ones
    lines = ["window-rule {", "    open-floating true"]
    if size:
        lines += [f"    default-column-width {{ fixed {size[0]}; }}",
                  f"    default-window-height {{ fixed {size[1]}; }}"]
    for e in EXCLUDE:
        lines.append("    exclude " + " ".join(f'{k}=r#"{rx}"#' for k, rx in e.items()))
    return head + "// desk mode: no focus-follows-mouse\n" + "\n".join(lines + ["}"]) + "\n"


def output_size(ws_id):
    """Logical size of the screen showing workspace ws_id."""
    wss = request("Workspaces").get("Ok", {}).get("Workspaces", [])
    name = next((w["output"] for w in wss if w["id"] == ws_id), None)
    outs = request("Outputs").get("Ok", {}).get("Outputs", {})
    o = outs.get(name) or next(iter(outs.values()), None)
    if not o or not o.get("logical"):
        return None
    return o["logical"]["width"], o["logical"]["height"]


def screen_sized(size):
    """As large as a screen in both directions: fullscreen, not a terminal size."""
    outputs = request("Outputs").get("Ok", {}).get("Outputs", {}).values()
    return any(o.get("logical") and size[0] >= o["logical"]["width"] and size[1] >= o["logical"]["height"]
               for o in outputs)


class Sizer:
    def __init__(self):
        self.size = load_size()
        self.desk = desk_mode()
        self.stamp = stamp()
        self.wins = {}      # id → (app id, floating)
        self.ws = {}        # id → workspace id
        self.steps = {}     # workspace id → step of the window opened there last
        self.ruled = set()  # windows the rule opened floating, to tile when desk mode ends
        self.pending = {}   # fallback: new tiled windows waiting to turn floating: id → deadline
        self.quiet = {}     # id → until when its size changes are not by hand
        self.center = {}    # windows to keep centred: id → (deadline, size centred at, offset)
        self.entering = 0.0 # until when windows turning floating come from tiling → desk
        self.cascade = 0    # windows placed since then
        self.refit_at = None  # when to scroll the view after desk → tiling
        self.retile = {}    # windows that turned tiled: id → when to give them the default width
        self.geom = {}      # floating windows: id → (window size, position on the screen)
        self.maxed = {}     # desk mode, maximized as floating: id → (size, position) to go back to
        self.unmaxed = set()  # maxed windows that turned tiled on desk → tiling: default width
        self.save = None    # size to write once the resizing stops
        self.save_at = 0.0
        self.write_rule()

    def write_rule(self):
        text = rule_text(self.desk, self.size)
        try:
            if RULE_FILE.read_text() == text:
                return
        except OSError:
            pass
        write_atomic(RULE_FILE, text)
        request({"Action": {"LoadConfigFile": {}}})

    def poll(self):
        """The mode or the size file changed (yami, or an edit by hand)."""
        now_stamp = stamp()
        if now_stamp == self.stamp:
            return
        self.stamp = now_stamp
        desk = desk_mode()
        if desk and not self.desk:
            self.entering, self.cascade = time.monotonic() + PENDING, 0
        if self.desk and not desk:
            self.refit_at = time.monotonic() + REFIT_AFTER
            for wid in self.ruled:
                if self.wins.get(wid, ("", False))[1]:
                    self.quiet[wid] = time.monotonic() + SETTLE
                    request({"Action": {"ToggleWindowFloating": {"id": wid}}})
            self.ruled.clear()
            self.unmaxed |= set(self.maxed)
            self.maxed.clear()
        self.desk = desk
        self.size = load_size() or self.size
        self.write_rule()

    def refit(self):
        """Scroll the view to the left edge, keeping the focused window."""
        self.refit_at = None
        w = request("FocusedWindow").get("Ok", {}).get("FocusedWindow")
        if w and not w["is_floating"]:
            request({"Action": {"FocusColumnLast": {}}})
            request({"Action": {"FocusColumnFirst": {}}})
            request({"Action": {"FocusWindow": {"id": w["id"]}}})

    def retile_due(self, now):
        """Default column width for windows that turned tiled, unless they were maximized."""
        due = [wid for wid, t in self.retile.items() if now >= t]
        if not due:
            return
        wins = {w["id"]: w for w in request("Windows").get("Ok", {}).get("Windows", [])}
        for wid in due:
            del self.retile[wid]
            w = wins.get(wid)
            if not w or w["is_floating"]:
                continue
            if self.maximized(wid, w["layout"]):
                if self.desk:
                    self.maximize_floating(wid, now)
                continue   # maximized: stays as large as the screen
            self.unmaxed.discard(wid)
            self.quiet[wid] = now + SETTLE
            request({"Action": {"SetWindowWidth": {"id": wid, "change": {"SetProportion": TILE_WIDTH}}}})

    def maximized(self, wid, layout):
        """A tiled window as wide as its screen, and not just a maxed one tiled by desk → tiling."""
        if wid in self.unmaxed:
            return False
        out = output_size(self.ws.get(wid))
        return bool(out) and layout["tile_size"][0] >= MAXIMIZED * out[0]

    def maximize_floating(self, wid, now):
        """Desk mode: a window niri maximized as a tile is floated again, as large as
        the screen; if it was maximized like that already, it gets its old size and place."""
        self.quiet[wid] = now + SETTLE
        back = self.maxed.pop(wid, None) if wid in self.maxed else False
        g = self.geom.get(wid)
        out = output_size(self.ws.get(wid))
        if back is False and g and out and g[0][0] >= MAXIMIZED * out[0]:
            back = None   # floated at full size already (maxed before a restart): make it small
        if back is False:
            self.maxed[wid] = self.geom.get(wid)
        request({"Action": {"ToggleWindowFloating": {"id": wid}}})
        if back is False:
            request({"Action": {"SetWindowWidth": {"id": wid, "change": {"SetProportion": 100.0}}}})
            request({"Action": {"SetWindowHeight": {"id": wid, "change": {"SetProportion": 100.0}}}})
            request({"Action": {"MoveFloatingWindow": {"id": wid, "x": {"SetFixed": 0.0}, "y": {"SetFixed": 0.0}}}})
        else:
            if not back:
                # old place unknown: the terminal size in the middle
                size = self.size or (1038, 621)
                request({"Action": {"SetWindowWidth": {"id": wid, "change": {"SetFixed": size[0]}}}})
                request({"Action": {"SetWindowHeight": {"id": wid, "change": {"SetFixed": size[1]}}}})
                self.centre(wid, (0, 0))
                self.center[wid] = (now + CENTER, None, (0, 0))
                request({"Action": {"FocusWindow": {"id": wid}}})
                return
            (bw, bh), (bx, by) = back
            request({"Action": {"SetWindowWidth": {"id": wid, "change": {"SetFixed": bw}}}})
            request({"Action": {"SetWindowHeight": {"id": wid, "change": {"SetFixed": bh}}}})
            # positions over IPC are in the working area, the layout's on the screen:
            # move by the difference to where it is now
            wins = request("Windows").get("Ok", {}).get("Windows", [])
            pos = next((w["layout"]["tile_pos_in_workspace_view"] for w in wins if w["id"] == wid), None)
            if pos:
                request({"Action": {"MoveFloatingWindow": {"id": wid, "x": {"AdjustFixed": bx - pos[0]}, "y": {"AdjustFixed": by - pos[1]}}}})
        request({"Action": {"FocusWindow": {"id": wid}}})

    def apply(self, wid, now, size=None, offset=(0, 0)):
        """Size a window yami floated and centre it (then moved by offset px right and down)."""
        if size is None:
            self.size = load_size() or self.size
            size = self.size
        if size:
            request({"Action": {"SetWindowWidth": {"id": wid, "change": {"SetFixed": size[0]}}}})
            request({"Action": {"SetWindowHeight": {"id": wid, "change": {"SetFixed": size[1]}}}})
        self.centre(wid, offset)
        self.center[wid] = (now + CENTER, None, offset)
        self.quiet[wid] = now + SETTLE

    def centre(self, wid, offset):
        request({"Action": {"CenterWindow": {"id": wid}}})
        if offset != (0, 0):
            request({"Action": {"MoveFloatingWindow": {"id": wid, "x": {"AdjustFixed": offset[0]}, "y": {"AdjustFixed": offset[1]}}}})

    def step_offset(self, w):
        """Where a new window goes from the middle: one STEP further up and right
        than the last one opened on its workspace, from the middle again on an
        empty workspace or when the step would leave the screen."""
        wid, ws = w["id"], w["workspace_id"]
        alone = not any(other == ws for i, other in self.ws.items() if i != wid)
        n = 0 if alone else self.steps.get(ws, 0) + 1
        out = output_size(ws)
        if not out:
            return 0, 0
        size = (w.get("layout") or {}).get("tile_size") or self.size or out
        dx, dy = STEP * out[0], STEP * out[1]
        room_x = (out[0] - size[0]) / 2
        room_y = (out[1] - size[1]) / 2 - STEP_ROOM
        if n * dx > room_x or n * dy > room_y:
            n = 0
        self.steps[ws] = n
        return round(n * dx), -round(n * dy)

    def place(self, wid, now, offset):
        """Move a window that opened floating in the middle by offset, also once its size has arrived."""
        if offset == (0, 0):
            return
        self.centre(wid, offset)
        self.center[wid] = (now + CENTER, None, offset)

    def from_tiling(self, w, now):
        """A window yami just floated on tiling → desk: give it a window shape if it has none."""
        out = output_size(w["workspace_id"])
        size = w["layout"]["window_size"]
        if not out or size[1] < TALL * out[1]:
            return   # floated before: keeps its size and place
        if w["app_id"] in APPS:
            size = load_size() or self.size or (round(out[0] * DESK_SIZE[0]), round(out[1] * DESK_SIZE[1]))
        else:
            size = (round(out[0] * DESK_SIZE[0]), round(out[1] * DESK_SIZE[1]))
        c = CASCADE * (self.cascade % 8)
        self.apply(w["id"], now, size, (c, c))
        self.cascade += 1

    def event(self, ev, now):
        kind, d = next(iter(ev.items()))
        if kind == "WindowsChanged":
            self.wins = {w["id"]: (w["app_id"], w["is_floating"]) for w in d["windows"]}
            self.ws = {w["id"]: w["workspace_id"] for w in d["windows"]}
            for w in d["windows"]:
                self.note_geom(w["id"], w["is_floating"], w["layout"])
        elif kind == "WindowOpenedOrChanged":
            w = d["window"]
            wid, app, floating = w["id"], w["app_id"], w["is_floating"]
            before = self.wins.get(wid)
            self.wins[wid] = (app, floating)
            self.ws[wid] = w["workspace_id"]
            self.note_geom(wid, floating, w["layout"])
            if before and before[1] and not floating:
                self.retile[wid] = now + (RETILE_DESK if self.desk else RETILE_AFTER)
            if before and not before[1] and floating:
                self.poll()   # the mode file may be newer than this loop's look at it
                if now < self.entering and wid not in self.pending:
                    self.quiet[wid] = now + SETTLE
                    self.from_tiling(w, now)
                    return
            if before is None and excluded(w):
                return
            if before is None:
                if desk_mode():
                    if floating:
                        # opened by the rule: at its size in the middle, now stepped up and right
                        self.ruled.add(wid)
                        self.quiet[wid] = now + SETTLE
                        self.place(wid, now, self.step_offset(w))
                    else:
                        self.pending[wid] = now + PENDING
            elif before[1] != floating:
                self.quiet[wid] = now + SETTLE
                if not floating:
                    self.ruled.discard(wid)
                if floating and self.pending.pop(wid, 0) >= now:
                    self.apply(wid, now, offset=self.step_offset(w))
        elif kind == "WindowClosed":
            for m in (self.wins, self.ws, self.pending, self.quiet, self.center, self.retile,
                      self.geom, self.maxed):
                m.pop(d["id"], None)
            self.unmaxed.discard(d["id"])
            self.ruled.discard(d["id"])
        elif kind == "WindowLayoutsChanged":
            for wid, layout in d["changes"]:
                app, floating = self.wins.get(wid, ("", False))
                size = tuple(layout["window_size"])
                self.note_geom(wid, floating, layout)
                if wid in self.retile and not floating and self.maximized(wid, layout):
                    # it turned tiled to be maximized: as soon as niri has it at full width
                    del self.retile[wid]
                    if self.desk:
                        self.maximize_floating(wid, now)
                    continue
                if wid in self.center:
                    until, centred, offset = self.center[wid]
                    if now >= until or not floating:
                        del self.center[wid]
                    elif size != centred:
                        # the new size has arrived: centre again with it
                        self.centre(wid, offset)
                        self.center[wid] = (until, size, offset)
                if (app in APPS and floating and wid not in self.pending and wid not in self.maxed
                        and now >= self.quiet.get(wid, 0)):
                    if size != self.size:
                        self.save, self.save_at = size, now + SAVE_AFTER

    def note_geom(self, wid, floating, layout):
        """Keep where a floating window is, to put it back there after maximizing."""
        pos = layout.get("tile_pos_in_workspace_view")
        if floating and pos and wid not in self.maxed:
            self.geom[wid] = (tuple(layout["window_size"]), tuple(pos))

    def flush(self):
        size, self.save = self.save, None
        if size and not screen_sized(size):
            self.size = size
            save_size(size)
            self.stamp = stamp()
            self.write_rule()


def main():
    if not os.environ.get("NIRI_SOCKET"):
        sys.exit("desk-term-size: NIRI_SOCKET is not set (run it from niri)")
    sizer = Sizer()
    with socket.socket(socket.AF_UNIX) as s:
        s.connect(os.environ["NIRI_SOCKET"])
        s.sendall(b'"EventStream"\n')
        buf = b""
        while True:
            wait = POLL
            if sizer.save:
                wait = min(wait, max(0.0, sizer.save_at - time.monotonic()))
            if sizer.refit_at:
                wait = min(wait, max(0.0, sizer.refit_at - time.monotonic()))
            if sizer.retile:
                wait = min(wait, max(0.0, min(sizer.retile.values()) - time.monotonic()))
            ready = select.select([s], [], [], wait)[0]
            if sizer.save and time.monotonic() >= sizer.save_at:
                sizer.flush()
            if sizer.refit_at and time.monotonic() >= sizer.refit_at:
                sizer.refit()
            sizer.retile_due(time.monotonic())
            sizer.poll()
            if not ready:
                continue
            chunk = s.recv(65536)
            if not chunk:
                return   # niri has ended
            buf += chunk
            *lines, buf = buf.split(b"\n")
            for line in lines:
                ev = json.loads(line)
                if "Ok" not in ev:
                    sizer.event(ev, time.monotonic())


if __name__ == "__main__":
    main()
