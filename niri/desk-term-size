#!/usr/bin/env python3
"""New terminals in yami's desk mode open floating, centred, at the last size.

niri opens every window tiled; in desk mode yami then makes it floating, so a
terminal would first show up tall in the tiling and then jump. Instead this
keeps a niri window rule in ~/.local/state/desk-mode.kdl (included at the end
of niri/user.kdl): in desk mode it opens kitty floating at the size a
terminal had when one was last resized by hand, and niri places a window
that opens floating in the middle of the screen; in tiling mode the file
holds no rule.

The same file switches focus-follows-mouse: on in tiling mode, off in desk
mode, where a click focuses and raises a window. With it on, hovering
focused a window without raising it, and yami, which draws the title bars
for the focused window as the top one, put titles over the windows in front.
niri cannot switch the setting off in a later file, so install.sh comments
it out of yami's config.kdl and it is only set here. The file is rewritten
when the mode changes (yami writes ~/.local/state/yami/stacking) and when the
size changes, then niri reloads.

Switching tiling → desk: yami makes every window floating, and niri keeps a
window that never floated at its tiled size and place (full height, side by
side), so it still looks tiled. Such windows (nearly as tall as the screen)
get a window size here: terminals the saved one, others 60 % × 70 % of the
screen; they are centred, each one a little further down and right, so every
title bar stays visible. Windows that floated before keep their size and
place. (The order yami floats them in is fixed by yami/patches/0002.)

The other way round (desk → tiling, or Mod+G), niri makes the column as wide
as the floating window was, so two terminals together were wider than the
screen. A window that turns tiled gets the default column width instead.
niri keeps the view scrolled as it was for the wider columns, so shortly
after desk → tiling the focus goes to the last column, the first and back:
niri scrolls only as far as needed each time, which leaves the view
starting at the left edge.

yami turns only the windows it floated itself back into tiles when desk mode
is switched off, so the terminals floated by the rule are tiled again here.

The size is kept in ~/.local/state/desk-term-size.json, so it survives
logging out; editing that file by hand works too. A size counts only when a
floating terminal is resized by hand: changes right after a window turned
floating or tiled (desk ↔ tiling, Mod+G), the ones made here and a window as
large as a screen (fullscreen) are left out.

Fallback: a terminal that still opens tiled in desk mode (opened in the
moment desk mode was switched on, before the rule is written) is sized and
centred once yami has floated it.

Started by niri (niri/user.kdl, spawn-sh-at-startup); ends with niri.
"""
import json
import os
import select
import socket
import sys
import time
from pathlib import Path

APPS = {"kitty"}    # app ids that count as the terminal
SETTLE = 1.0        # s after a floating change or a resize from here: not by hand
PENDING = 5.0       # s a new terminal may take to turn floating
SAVE_AFTER = 0.5    # s without further resizing before the size is written
CENTER = 1.0        # s after the fallback in which a size change centres again
POLL = 0.3          # s between looks at the mode and size files
TALL = 0.85         # a floating window this much of the screen high still has its tiled shape
DESK_SIZE = (0.6, 0.7)  # share of the screen such a window gets (terminals: the saved size)
CASCADE = 32        # px each further window moves down and right
TILE_WIDTH = 50.0   # % column width a window gets when it turns tiled (yami's default-column-width)
REFIT_AFTER = 0.6   # s after desk → tiling before the view is scrolled to fit

STATE = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
SIZE_FILE = STATE / "desk-term-size.json"
RULE_FILE = STATE / "desk-mode.kdl"   # included by niri/user.kdl
FOCUS_FOLLOWS_MOUSE = 'focus-follows-mouse max-scroll-amount="0%"'   # as yami had it
DESK_FILE = STATE / "yami/stacking"   # yami writes 1 in desk mode, 0 in tiling


def request(req):
    with socket.socket(socket.AF_UNIX) as s:
        s.connect(os.environ["NIRI_SOCKET"])
        s.sendall((json.dumps(req) + "\n").encode())
        return json.loads(s.makefile().readline())


def desk_mode():
    try:
        return DESK_FILE.read_text().strip() == "1"
    except OSError:
        return False


def load_size():
    try:
        d = json.loads(SIZE_FILE.read_text())
        return int(d["width"]), int(d["height"])
    except (OSError, ValueError, KeyError, TypeError):
        return None


def write_atomic(path, text):
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


def save_size(size):
    write_atomic(SIZE_FILE, json.dumps({"width": size[0], "height": size[1]}) + "\n")


def stamp():
    """What the mode and size files look like now, to notice changes."""
    out = []
    for f in (DESK_FILE, SIZE_FILE):
        try:
            st = f.stat()
            out.append((st.st_mtime_ns, st.st_size))
        except OSError:
            out.append(None)
    return out


def rule_text(desk, size):
    head = "// written by desk-term-size (purpleDotfiles/niri); changes are overwritten\n"
    if not desk:
        return head + "// tiling mode\ninput {\n    " + FOCUS_FOLLOWS_MOUSE + "\n}\n"
    apps = "|".join(sorted(APPS))
    lines = ["window-rule {", f'    match app-id="^({apps})$"', "    open-floating true"]
    if size:
        lines += [f"    default-column-width {{ fixed {size[0]}; }}",
                  f"    default-window-height {{ fixed {size[1]}; }}"]
    return head + "// desk mode: no focus-follows-mouse\n" + "\n".join(lines + ["}"]) + "\n"


def output_size(ws_id):
    """Logical size of the screen showing workspace ws_id."""
    wss = request("Workspaces").get("Ok", {}).get("Workspaces", [])
    name = next((w["output"] for w in wss if w["id"] == ws_id), None)
    outs = request("Outputs").get("Ok", {}).get("Outputs", {})
    o = outs.get(name) or next(iter(outs.values()), None)
    if not o or not o.get("logical"):
        return None
    return o["logical"]["width"], o["logical"]["height"]


def screen_sized(size):
    """As large as a screen in both directions: fullscreen, not a terminal size."""
    outputs = request("Outputs").get("Ok", {}).get("Outputs", {}).values()
    return any(o.get("logical") and size[0] >= o["logical"]["width"] and size[1] >= o["logical"]["height"]
               for o in outputs)


class Sizer:
    def __init__(self):
        self.size = load_size()
        self.desk = desk_mode()
        self.stamp = stamp()
        self.wins = {}      # id → (app id, floating)
        self.ruled = set()  # terminals the rule opened floating, to tile when desk mode ends
        self.pending = {}   # fallback: new tiled terminals waiting to turn floating: id → deadline
        self.quiet = {}     # id → until when its size changes are not by hand
        self.center = {}    # windows to keep centred: id → (deadline, size centred at, offset)
        self.entering = 0.0 # until when windows turning floating come from tiling → desk
        self.cascade = 0    # windows placed since then
        self.refit_at = None  # when to scroll the view after desk → tiling
        self.save = None    # size to write once the resizing stops
        self.save_at = 0.0
        self.write_rule()

    def write_rule(self):
        text = rule_text(self.desk, self.size)
        try:
            if RULE_FILE.read_text() == text:
                return
        except OSError:
            pass
        write_atomic(RULE_FILE, text)
        request({"Action": {"LoadConfigFile": {}}})

    def poll(self):
        """The mode or the size file changed (yami, or an edit by hand)."""
        now_stamp = stamp()
        if now_stamp == self.stamp:
            return
        self.stamp = now_stamp
        desk = desk_mode()
        if desk and not self.desk:
            self.entering, self.cascade = time.monotonic() + PENDING, 0
        if self.desk and not desk:
            self.refit_at = time.monotonic() + REFIT_AFTER
            for wid in self.ruled:
                if self.wins.get(wid, ("", False))[1]:
                    self.quiet[wid] = time.monotonic() + SETTLE
                    request({"Action": {"ToggleWindowFloating": {"id": wid}}})
            self.ruled.clear()
        self.desk = desk
        self.size = load_size() or self.size
        self.write_rule()

    def refit(self):
        """Scroll the view to the left edge, keeping the focused window."""
        self.refit_at = None
        w = request("FocusedWindow").get("Ok", {}).get("FocusedWindow")
        if w and not w["is_floating"]:
            request({"Action": {"FocusColumnLast": {}}})
            request({"Action": {"FocusColumnFirst": {}}})
            request({"Action": {"FocusWindow": {"id": w["id"]}}})

    def apply(self, wid, now, size=None, offset=0):
        """Size a window yami floated and centre it (moved by offset px down and right)."""
        if size is None:
            self.size = load_size() or self.size
            size = self.size
        if size:
            request({"Action": {"SetWindowWidth": {"id": wid, "change": {"SetFixed": size[0]}}}})
            request({"Action": {"SetWindowHeight": {"id": wid, "change": {"SetFixed": size[1]}}}})
        self.centre(wid, offset)
        self.center[wid] = (now + CENTER, None, offset)
        self.quiet[wid] = now + SETTLE

    def centre(self, wid, offset):
        request({"Action": {"CenterWindow": {"id": wid}}})
        if offset:
            request({"Action": {"MoveFloatingWindow": {"id": wid, "x": {"AdjustFixed": offset}, "y": {"AdjustFixed": offset}}}})

    def from_tiling(self, w, now):
        """A window yami just floated on tiling → desk: give it a window shape if it has none."""
        out = output_size(w["workspace_id"])
        size = w["layout"]["window_size"]
        if not out or size[1] < TALL * out[1]:
            return   # floated before: keeps its size and place
        if w["app_id"] in APPS:
            size = load_size() or self.size or (round(out[0] * DESK_SIZE[0]), round(out[1] * DESK_SIZE[1]))
        else:
            size = (round(out[0] * DESK_SIZE[0]), round(out[1] * DESK_SIZE[1]))
        self.apply(w["id"], now, size, CASCADE * (self.cascade % 8))
        self.cascade += 1

    def event(self, ev, now):
        kind, d = next(iter(ev.items()))
        if kind == "WindowsChanged":
            self.wins = {w["id"]: (w["app_id"], w["is_floating"]) for w in d["windows"]}
        elif kind == "WindowOpenedOrChanged":
            w = d["window"]
            wid, app, floating = w["id"], w["app_id"], w["is_floating"]
            before = self.wins.get(wid)
            self.wins[wid] = (app, floating)
            if before and before[1] and not floating:
                request({"Action": {"SetWindowWidth": {"id": wid, "change": {"SetProportion": TILE_WIDTH}}}})
            if before and not before[1] and floating:
                self.poll()   # the mode file may be newer than this loop's look at it
                if now < self.entering and wid not in self.pending:
                    self.quiet[wid] = now + SETTLE
                    self.from_tiling(w, now)
                    return
            if app not in APPS:
                return
            if before is None:
                if desk_mode():
                    if floating:
                        # opened by the rule: already at its size and place
                        self.ruled.add(wid)
                        self.quiet[wid] = now + SETTLE
                    else:
                        self.pending[wid] = now + PENDING
            elif before[1] != floating:
                self.quiet[wid] = now + SETTLE
                if not floating:
                    self.ruled.discard(wid)
                if floating and self.pending.pop(wid, 0) >= now:
                    self.apply(wid, now)
        elif kind == "WindowClosed":
            for m in (self.wins, self.pending, self.quiet, self.center):
                m.pop(d["id"], None)
            self.ruled.discard(d["id"])
        elif kind == "WindowLayoutsChanged":
            for wid, layout in d["changes"]:
                app, floating = self.wins.get(wid, ("", False))
                size = tuple(layout["window_size"])
                if wid in self.center:
                    until, centred, offset = self.center[wid]
                    if now >= until or not floating:
                        del self.center[wid]
                    elif size != centred:
                        # the new size has arrived: centre again with it
                        self.centre(wid, offset)
                        self.center[wid] = (until, size, offset)
                if app in APPS and floating and wid not in self.pending and now >= self.quiet.get(wid, 0):
                    if size != self.size:
                        self.save, self.save_at = size, now + SAVE_AFTER

    def flush(self):
        size, self.save = self.save, None
        if size and not screen_sized(size):
            self.size = size
            save_size(size)
            self.stamp = stamp()
            self.write_rule()


def main():
    if not os.environ.get("NIRI_SOCKET"):
        sys.exit("desk-term-size: NIRI_SOCKET is not set (run it from niri)")
    sizer = Sizer()
    with socket.socket(socket.AF_UNIX) as s:
        s.connect(os.environ["NIRI_SOCKET"])
        s.sendall(b'"EventStream"\n')
        buf = b""
        while True:
            wait = POLL
            if sizer.save:
                wait = min(wait, max(0.0, sizer.save_at - time.monotonic()))
            if sizer.refit_at:
                wait = min(wait, max(0.0, sizer.refit_at - time.monotonic()))
            ready = select.select([s], [], [], wait)[0]
            if sizer.save and time.monotonic() >= sizer.save_at:
                sizer.flush()
            if sizer.refit_at and time.monotonic() >= sizer.refit_at:
                sizer.refit()
            sizer.poll()
            if not ready:
                continue
            chunk = s.recv(65536)
            if not chunk:
                return   # niri has ended
            buf += chunk
            *lines, buf = buf.split(b"\n")
            for line in lines:
                ev = json.loads(line)
                if "Ok" not in ev:
                    sizer.event(ev, time.monotonic())


if __name__ == "__main__":
    main()
